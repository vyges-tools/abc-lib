# SPDX-License-Identifier: Apache-2.0
# Shared flags (C++ standard, -O3, no FP contraction, static archives, macOS minimum): a synced
# copy of vyges-tools/build-config bazel/common.bazelrc. Edit it there, then copy it here; CI
# checks this repository against the pinned build-config tag. Only ABC-specific lines follow.
import %workspace%/build-config/common.bazelrc

# ⛔ No readline. ABC's readline option links GNU readline (GPL) into the archive; this crate drives
# ABC through its command API and never reads a terminal.
common --@abc//:use_readline=false

build --per_file_copt=.*external/abc.*@-stdlib=libc++
build --host_per_file_copt=.*external/abc.*@-stdlib=libc++
