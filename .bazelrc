# SPDX-License-Identifier: Apache-2.0
common --enable_bzlmod
common --check_direct_dependencies=off

# ⛔ No readline. ABC's readline option links GNU readline (GPL) into the archive; this crate drives
# ABC through its command API and never reads a terminal.
common --@abc//:use_readline=false

build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build -c opt
build --copt=-O3

# ⛔ No fused multiply-add contraction: each floating-point operation rounds as IEEE 754 says,
# whatever the optimiser inlines. ABC's mappers compare delays and areas held in floats.
build --copt=-ffp-contract=off --host_copt=-ffp-contract=off

build --dynamic_mode=off
build --per_file_copt=.*external/.*@-w
build --host_per_file_copt=.*external/.*@-w
build --per_file_copt=.*external/abc.*@-stdlib=libc++
build --host_per_file_copt=.*external/abc.*@-stdlib=libc++

common --enable_platform_specific_config
build:macos --macos_minimum_os=13.3
build:macos --host_macos_minimum_os=13.3
