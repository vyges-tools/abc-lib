#
# Builds ABC (logic synthesis and verification, UC Berkeley) into ONE static archive, plus the C
# shim in `shim/`, for the Rust crate in this repository to link.
#
# ⛔ The version below is deliberate, not "latest". ABC's rewriting, mapping and proof engines make
# choices that depend on its exact source, so a different release can return a different (equally
# valid) network or take a different proof path. Pin, and bump on purpose — see `abc-pin.yaml`.

module(
    name = "vyges_abc",
    version = "0.1.0",
)

bazel_dep(name = "abc", version = "0.64-yosyshq.bcr.2")
bazel_dep(name = "rules_cc", version = "0.2.22")

# ⛔ THE TRANSITIVE SET IS PINNED TOO (Bazel's MVS takes the highest version anything asks for).
# Keep this block in step with `abc-pin.yaml`.
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "zlib", version = "1.3.1.bcr.7")

# Hermetic LLVM: the compiler is part of the pin, not whatever the host has.
bazel_dep(name = "llvm", version = "0.8.18", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)
