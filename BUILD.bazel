load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "shim",
    srcs = ["shim/vyges_abc.cc"],
    hdrs = ["shim/vyges_abc.h"],
    deps = ["@abc"],
)

# ONE archive with the shim and every object it needs (ABC, zlib), so the Rust build links a single
# `libvyges_abc.a` and nothing from the host.
cc_static_library(
    name = "vyges_abc",
    deps = [":shim"],
)
